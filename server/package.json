{
  "name": "wearsuper-api",
  "version": "1.0.0",
  "private": true,
  "description": "WEARSUPER store API — Express, MongoDB (Mongoose), JWT auth",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "dev:memory": "node scripts/dev-memory.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0"
  }
}
