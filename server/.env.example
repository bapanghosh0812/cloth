# Copy this file to server/.env and fill in the values. Never commit server/.env.

# MongoDB Atlas → your cluster → Connect → Drivers → copy the connection string as shown,
# then replace <db_password> (including the < >) with your database user's password.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority

# Database name inside the cluster (optional).
MONGODB_DB=wearsuper

# Long random string used to sign login tokens (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login stays valid.
JWT_EXPIRES_IN=7d

# Other sites allowed to call this API from a browser (comma-separated, no trailing slash).
# Not needed on Netlify, where the site and the API share one address.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

PORT=5000
