# Copy this file to server/.env and fill in the values. Never commit server/.env.

# MongoDB Atlas → your cluster → Connect → Drivers → copy the connection string.
# Replace <username>/<password> with your *database user*, and add the database name (wearsuper).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/wearsuper?retryWrites=true&w=majority

# Long random string used to sign login tokens (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login stays valid.
JWT_EXPIRES_IN=7d

# Sites allowed to call this API from a browser (comma-separated, no trailing slash).
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

PORT=5000
